#!/data/data/com.termux/files/usr/bin/bash

GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${GREEN}[*] Initializing Magasploit Spider...${NC}"
echo -n "Enter target URL: "
read target

if [ -z "$target" ]; then
    echo -e "${RED}[!] Error: No target specified.${NC}"
    exit 1
fi

echo -e "${BLUE}[+] Scanning $target...${NC}"

server=$(curl -Is "$target" | grep -i "server" | cut -d' ' -f2)
echo -e "${GREEN}[*] Server: ${NC}${server:-Unknown}"

paths=("admin" "login" "config" "db" ".git" "backup" "shell.php")

for path in "${paths[@]}"; do
    status=$(curl -o /dev/null -s -w "%{http_code}" "$target/$path")
    if [ "$status" == "200" ] || [ "$status" == "301" ]; then
        echo -e "${GREEN}[!] FOUND: $target/$path ($status)${NC}"
    else
        echo -e "[-] $path ($status)"
    fi
done

echo -e "${BLUE}[*] Finished.${NC}"

