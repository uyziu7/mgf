#!/data/data/com.termux/files/usr/bin/bash

GREEN='\033[0;32m'
NC='\033[0m'

echo -n "Target (URL or File): "
read target

echo -e "${GREEN}[*] Extracting data from $target...${NC}"

if [[ $target == http* ]]; then
    content=$(curl -s "$target")
else
    content=$(cat "$target" 2>/dev/null)
fi

if [ -z "$content" ]; then
    echo "Error: Could not read target."
    exit 1
fi

echo -e "\n${GREEN}[+] Emails found:${NC}"
echo "$content" | grep -Eoi '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,4}' | sort -u

echo -e "\n${GREEN}[+] IP Addresses found:${NC}"
echo "$content" | grep -Eoi '([0-9]{1,3}\.){3}[0-9]{1,3}' | sort -u

echo -e "\n${GREEN}[+] Links found:${NC}"
echo "$content" | grep -Eoi '(http|https)://[a-zA-Z0-9./?=_-]+' | sort -u

